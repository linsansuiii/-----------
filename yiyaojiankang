  <!-- JavaScript 逻辑区 -->
  <script>
    // --- 数据定义 ---

    const agendaData = [
      { time: '08:30 - 09:00', title: '嘉宾签到', desc: '签到处进行电子签到，领取会议手册及参会证件。' },
      { time: '09:00 - 09:20', title: '领导致辞', desc: '佛山市卫健局、科技局等相关部门领导开场致辞。' },
      { time: '09:20 - 10:00', title: '“医工融合”主题演讲', desc: '特邀知名院士及行业顶尖专家分享医疗器械前沿趋势与融合创新路径。' },
      { time: '10:00 - 10:40', title: '相关产业政策宣贯', desc: '详细解读最新生物医药与健康产业扶持政策及申报指南。' },
      { time: '10:40 - 11:30', title: '重点企业路演与技术推介', desc: '遴选4家优质创新企业进行项目路演，展示最新医工转化成果。' },
      { time: '11:30 - 12:00', title: '自由对接交流', desc: '设立专区，供参会企业、投资机构、科研院所进行面对面深度洽谈。' },
    ];

    const policyData = [
      {
        dept: '佛山市卫生健康局',
        title: '关于支持医疗机构开展医工交叉协同创新的若干措施',
        desc: '鼓励医疗机构与科研院所、企业联合开展医疗器械及生物医药创新研发，提供临床试验绿色通道。',
        details: '一、设立专项联合研发基金，首期投入5000万元，支持医疗机构主导的早期研发。\n二、建立市级三甲医院临床试验（GCP）快速伦理审查机制，承诺5个工作日内完成初审。\n三、鼓励医务人员参与创新，对成功实现成果转化的医护人员，可给予不低于70%的科技成果转化收益分配比例。'
      },
      {
        dept: '佛山市科学技术局',
        title: '佛山市生物医药与健康产业科技创新专项资金申报指南',
        desc: '对重大技术攻关项目、创新平台建设给予最高500万元的科研资金补助。',
        details: '一、重点支持高端医疗装备、创新药及新型生物材料的核心技术攻关，单项资助最高500万元。\n二、支持企业联合医院共建重点实验室或工程技术研究中心，按建设投入的30%给予最高300万元补贴。\n三、对于获得国家级科技奖项的本地转化项目，给予1:1资金配套奖励。'
      },
      {
        dept: '佛山市工业和信息化局',
        title: '促进高端医疗器械产业集群高质量发展扶持办法',
        desc: '针对首次取得医疗器械注册证并在本地产业化的企业，给予专项产业化奖补。',
