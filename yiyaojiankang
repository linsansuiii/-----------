    ];

    // 全局状态 (供筛选功能使用)
    const enterpriseCategories = ['全部', '医疗器械', '体外诊断', '智慧医疗'];
    let activeCategory = '全部';
    let searchQuery = '';

    // --- DOM 渲染与交互 ---

    document.addEventListener('DOMContentLoaded', () => {
      // 1. 渲染议程
      const agendaContainer = document.getElementById('agenda-content');
      agendaData.forEach(item => {
        agendaContainer.innerHTML += `
          <div class="relative flex items-start gap-4">
            <div class="absolute left-0 w-5 h-5 rounded-full border-[3px] border-sky-500 bg-white mt-1"></div>
            <div class="ml-9 w-full bg-white p-4 rounded-xl shadow-sm border border-slate-50 text-base">
              <div class="text-sky-600 font-bold text-sm mb-1.5">${item.time}</div>
              <div class="text-gray-800 font-semibold mb-1.5">${item.title}</div>
              <div class="text-gray-500 text-sm leading-relaxed">${item.desc}</div>
            </div>
          </div>
        `;
      });

      // 2. 渲染政策
      const policiesContainer = document.getElementById('policies-container');
      policyData.forEach((policy, index) => {
        policiesContainer.innerHTML += `
          <div class="p-4 rounded-xl bg-gradient-to-br from-sky-50 to-white border border-sky-100 relative">
            <div class="flex justify-between items-center mb-3">
              <div class="text-sm font-bold text-white bg-sky-600 inline-block px-2.5 py-1 rounded">
                ${policy.dept}
              </div>
              <button onclick="openPolicyModal(${index})" class="text-xs text-sky-600 font-semibold flex items-center">
                了解更多 <i data-lucide="chevron-right" class="w-4 h-4"></i>
              </button>
            </div>
            <h3 class="text-base font-bold text-gray-800 mb-2">${policy.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed mb-1">${policy.desc}</p>
          </div>
        `;
      });

      // 初始化企业筛选 Tab 与 列表
      renderTabs();
      renderEnterprises();

      // 初始化全局图标
      lucide.createIcons();
    });

    // --- 企业分类筛选与搜索逻辑 ---

    function renderTabs() {
      const tabsContainer = document.getElementById('category-tabs');
      tabsContainer.innerHTML = '';
      
      enterpriseCategories.forEach(cat => {
        const isActive = cat === activeCategory;
        const btnClass = isActive 
          ? 'px-3.5 py-1.5 bg-sky-600 text-white rounded-lg text-sm font-medium whitespace-nowrap shadow-sm transition-colors'
          : 'px-3.5 py-1.5 bg-slate-100 text-slate-600 rounded-lg text-sm font-medium whitespace-nowrap hover:bg-slate-200 transition-colors cursor-pointer';
          
        tabsContainer.innerHTML += `
          <button onclick="setCategory('${cat}')" class="${btnClass}">
            ${cat}
          </button>
        `;
      });
    }

    function setCategory(cat) {
      activeCategory = cat;
      renderTabs();
      renderEnterprises();
    }

    function handleSearch(e) {
      searchQuery = e.target.value.toLowerCase().trim();
      renderEnterprises();
    }

    function renderEnterprises() {
      const container = document.getElementById('enterprises-container');
      container.innerHTML = '';
      
      // 过滤逻辑
      const filtered = enterprisesData.filter(ent => {
        const matchCategory = activeCategory === '全部' || ent.category === activeCategory;
        const matchSearch = ent.name.toLowerCase().includes(searchQuery);
        return matchCategory && matchSearch;
      });

      // 空状态展示
      if (filtered.length === 0) {
        container.innerHTML = `<div class="col-span-2 text-center py-8 text-sm text-gray-400 bg-slate-50 rounded-xl">没有找到匹配的企业</div>`;
        return;
      }

      // 渲染过滤后的企业
      filtered.forEach((ent) => {
        container.innerHTML += `
          <div class="group border border-slate-100 rounded-xl overflow-hidden shadow-sm bg-white cursor-pointer flex flex-col" onclick="openCompanyModal(${ent.id})">
            <div class="aspect-[3/4] w-full overflow-hidden bg-slate-100 relative">
              <img src="${ent.img}" alt="${ent.name}" class="w-full h-full object-cover" />
              <div class="absolute top-2 left-2 bg-black/50 backdrop-blur-md text-white text-[10px] px-2 py-0.5 rounded-sm">
                ${ent.category}
              </div>
            </div>
            <div class="p-3 flex-1 flex flex-col justify-center items-center text-center">
              <h4 class="text-sm font-bold text-gray-800 leading-snug" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${ent.name}</h4>
              <div class="mt-2 flex items-center text-xs text-sky-600 font-medium">
                了解详情 <i data-lucide="chevron-right" class="w-3.5 h-3.5 ml-0.5"></i>
              </div>
            </div>
          </div>
        `;
      });

      // 重新实例化新增 DOM 里的图标
      lucide.createIcons();
    }

    // --- 弹窗交互函数 ---

    function toggleAgenda() {
      const content = document.getElementById('agenda-content');
      const text = document.getElementById('agenda-toggle-text');
      const iconUp = document.getElementById('agenda-icon-up');
      const iconDown = document.getElementById('agenda-icon-down');
      
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        text.innerText = '收起';
        iconUp.classList.remove('hidden');
        iconDown.classList.add('hidden');
      } else {
        content.classList.add('hidden');
        text.innerText = '展开';
        iconUp.classList.add('hidden');
        iconDown.classList.remove('hidden');
      }
    }

    function openCompanyModal(id) {
      const company = enterprisesData.find(c => c.id === id);
      document.getElementById('modal-company-img').src = company.img;
      document.getElementById('modal-company-category').innerText = company.category;
      document.getElementById('modal-company-name').innerText = company.name;
      document.getElementById('modal-company-details').innerText = company.details;
      
      const modal = document.getElementById('company-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function openPolicyModal(index) {
      const policy = policyData[index];
      document.getElementById('modal-policy-dept').innerText = policy.dept;
      document.getElementById('modal-policy-title').innerText = policy.title;
      document.getElementById('modal-policy-details').innerText = policy.details;
      
      const modal = document.getElementById('policy-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function openEventModal() {
      const modal = document.getElementById('event-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  </script>
</body>
</html>
