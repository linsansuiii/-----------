          <p id="modal-policy-details" class="text-sm text-gray-600 leading-relaxed text-justify whitespace-pre-line"></p>
          <button onclick="closeModal('policy-modal')" class="mt-8 w-full py-3 bg-sky-50 text-sky-700 font-bold rounded-xl text-base">关闭</button>
