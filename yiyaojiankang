      <div class="bg-white rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl animate-in-zoom">
        <div class="p-6 max-h-[70vh] overflow-y-auto no-scrollbar relative">
          <button onclick="closeModal('policy-modal')" class="absolute top-4 right-4 text-gray-400">
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>
          <div id="modal-policy-dept" class="text-sm font-bold text-sky-600 mb-2"></div>
          <h2 id="modal-policy-title" class="text-lg font-bold text-gray-800 mb-4 pr-6"></h2>
