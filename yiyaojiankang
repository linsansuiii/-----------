        </div>
        <div class="p-6 max-h-[55vh] overflow-y-auto no-scrollbar">
          <div id="modal-company-category" class="text-xs font-bold text-sky-600 mb-1"></div>
          <h2 id="modal-company-name" class="text-xl font-bold text-gray-800 mb-4"></h2>
          <div class="w-12 h-1.5 bg-sky-500 rounded-full mb-5"></div>
          <p id="modal-company-details" class="text-base text-gray-600 leading-relaxed text-justify whitespace-pre-line"></p>
          <button onclick="closeModal('company-modal')" class="mt-8 w-full py-3 bg-sky-50 text-sky-700 font-bold rounded-xl text-base">关闭</button>
