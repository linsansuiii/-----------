          <img id="modal-company-img" src="" alt="封面" class="w-full h-56 object-cover" />
          <button onclick="closeModal('company-modal')" class="absolute top-4 right-4 bg-black/40 text-white p-2 rounded-full backdrop-blur-md">
            <i data-lucide="x" class="w-5 h-5"></i>
