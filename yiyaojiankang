      return `data:image/svg+xml;charset=UTF-8,%3Csvg width='400' height='533' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3ClinearGradient id='g1' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%23${color1}' /%3E%3Cstop offset='100%25' stop-color='%23${color2}' /%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='400' height='533' fill='url(%23g1)'/%3E%3Ctext x='200' y='266' font-family='sans-serif' font-size='32' font-weight='bold' fill='%23ffffff' text-anchor='middle' dominant-baseline='middle'%3E${text}%3C/text%3E%3C/svg%3E`;
